<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fitsSystemWindows="true"
    tools:context="com.openclassrooms.realestatemanager.ui.fragments.RealEstateDetailFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- Status Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/property_status_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:textColor="@android:color/white"
            app:chipBackgroundColor="@color/price_blue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Available" />

        <!-- Media Section -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/property_photos_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/property_status_chip"
            tools:listitem="@layout/item_property_photo" />

        <!-- Description Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/description_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/property_photos_recycler_view">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/property_description_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_description"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/property_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    tools:text="This is a beautiful property with many features and a great location." />

                <TextView
                    android:id="@+id/property_poi_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/label_poi"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/property_poi_chip_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacing="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/details_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/description_card">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <LinearLayout
                    android:id="@+id/metrics_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@+id/property_map_container"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/property_surface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="12dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/outline_expand_content_24"
                        tools:text="Surface: 120sqm" />

                    <TextView
                        android:id="@+id/property_rooms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:drawablePadding="12dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/outline_house_24"
                        tools:text="Rooms: 5" />

                    <TextView
                        android:id="@+id/property_bathrooms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:drawablePadding="12dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/outline_bathtub_24"
                        tools:text="Bathrooms: 2" />

                    <TextView
                        android:id="@+id/property_bedrooms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:drawablePadding="12dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/outline_bed_24"
                        tools:text="Bedrooms: 3" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/property_map_container"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/property_map"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_dialog_map"
                        tools:ignore="ContentDescription" />
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:id="@+id/divider_horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/divider_color"
                    app:layout_constraintTop_toBottomOf="@id/metrics_layout" />

                <TextView
                    android:id="@+id/property_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    app:drawableStartCompat="@drawable/outline_pin_drop_24"
                    app:layout_constraintTop_toBottomOf="@id/divider_horizontal"
                    tools:text="123 Example Street, 75001 Paris" />

                <LinearLayout
                    android:id="@+id/dates_agent_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/property_address">

                    <TextView
                        android:id="@+id/property_agent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        tools:text="Agent: Alexa" />

                    <TextView
                        android:id="@+id/property_add_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        tools:text="Added on: 15/09/2026" />

                    <TextView
                        android:id="@+id/property_sale_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/price_blue"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="Sold on: 20/09/2026"
                        tools:visibility="visible" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
